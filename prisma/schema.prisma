generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  ARCHIVED
}

enum UserRole {
  ADMIN
  MANAGER
  EDITOR
  CLIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CLIENT
  COMPLETED
  CLOSED
}

enum PortalDocumentStatus {
  UPLOADED
  REVIEWED
  REJECTED
  ARCHIVED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationChannel {
  EMAIL
  PORTAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model ServiceGroup {
  id        String    @id @default(cuid()) @db.VarChar(30)
  key       String    @unique @db.VarChar(60)
  name      String    @db.VarChar(100)
  tagline   String    @db.VarChar(180)
  sortOrder Int       @default(0)
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sortOrder])
}

model Service {
  id               String        @id @default(cuid()) @db.VarChar(30)
  groupId          String        @db.VarChar(30)
  slug             String        @unique @db.VarChar(120)
  name             String        @db.VarChar(120)
  shortDescription String        @db.VarChar(300)
  benefit          String        @db.VarChar(240)
  headline         String        @db.VarChar(180)
  introduction     String        @db.Text
  audience         Json?
  help             Json?
  process          Json?
  checklist        Json?
  status           PublishStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  metaTitle        String?       @db.VarChar(180)
  metaDescription  String?       @db.VarChar(320)
  ogImage          String?       @db.VarChar(500)
  group            ServiceGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  faqs             Faq[]
  relatedFrom      ServiceRelation[] @relation("RelatedFrom")
  relatedTo        ServiceRelation[] @relation("RelatedTo")
  leads            Lead[]
  cases            ClientCase[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([groupId, status, sortOrder])
  @@index([status, updatedAt])
}

model ServiceRelation {
  serviceId String  @db.VarChar(30)
  relatedId String  @db.VarChar(30)
  service   Service @relation("RelatedFrom", fields: [serviceId], references: [id], onDelete: Cascade)
  related   Service @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([serviceId, relatedId])
  @@index([relatedId])
}

model Faq {
  id        String        @id @default(cuid()) @db.VarChar(30)
  serviceId String?       @db.VarChar(30)
  question  String        @db.VarChar(300)
  answer    String        @db.Text
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  service   Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([serviceId, status, sortOrder])
}

model ContentPage {
  id              String        @id @default(cuid()) @db.VarChar(30)
  slug            String        @unique @db.VarChar(120)
  title           String        @db.VarChar(180)
  summary         String?       @db.VarChar(500)
  content         Json
  status          PublishStatus @default(DRAFT)
  metaTitle       String?       @db.VarChar(180)
  metaDescription String?       @db.VarChar(320)
  ogImage         String?       @db.VarChar(500)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, updatedAt])
}

model BlogPost {
  id              String        @id @default(cuid()) @db.VarChar(30)
  slug            String        @unique @db.VarChar(120)
  category        String        @db.VarChar(100)
  title           String        @db.VarChar(180)
  introduction    String        @db.Text
  prompts         Json?
  serviceSlug     String        @db.VarChar(120)
  image           String?       @db.VarChar(500)
  status          PublishStatus @default(DRAFT)
  sortOrder       Int           @default(0)
  metaTitle       String?       @db.VarChar(180)
  metaDescription String?       @db.VarChar(320)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([status, updatedAt])
}

model SiteSetting {
  id        String   @id @default(cuid()) @db.VarChar(30)
  key       String   @unique @db.VarChar(120)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustMetric {
  id        String        @id @default(cuid()) @db.VarChar(30)
  value     String        @db.VarChar(100)
  label     String        @db.VarChar(160)
  detail    String?       @db.VarChar(300)
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Testimonial {
  id          String        @id @default(cuid()) @db.VarChar(30)
  quote       String        @db.Text
  displayName String        @db.VarChar(120)
  role        String?       @db.VarChar(160)
  rating       Float?
  sourceUrl    String?       @db.VarChar(500)
  reviewedAt   DateTime?
  approvedAt  DateTime?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model CustomerFeedback {
  id         String        @id @default(cuid()) @db.VarChar(30)
  name       String        @db.VarChar(120)
  message    String        @db.Text
  rating     Int?
  status     PublishStatus @default(DRAFT)
  reviewedAt DateTime?
  approvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}

model Lead {
  id                  String     @id @default(cuid()) @db.VarChar(30)
  name                String     @db.VarChar(160)
  email               String?    @db.VarChar(254)
  phone               String?    @db.VarChar(40)
  nationality         String?    @db.VarChar(100)
  requirement         String     @db.Text
  preferredContact    String     @db.VarChar(20)
  preferredTime       String?    @db.VarChar(120)
  serviceId           String?    @db.VarChar(30)
  serviceNameAtSubmit String    @db.VarChar(120)
  status              LeadStatus @default(NEW)
  consentedAt         DateTime
  sourcePath          String?    @db.VarChar(500)
  contactedAt         DateTime?
  service             Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  notifications       Notification[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([serviceId, createdAt])
  @@index([email, createdAt])
}

model RateLimitEntry {
  id          String   @id @default(cuid()) @db.VarChar(30)
  keyHash     String   @db.Char(64)
  windowStart DateTime
  hits        Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([keyHash, windowStart])
  @@index([expiresAt])
}

model User {
  id                 String        @id @default(cuid()) @db.VarChar(30)
  email              String        @unique @db.VarChar(254)
  passwordHash       String        @db.VarChar(255)
  name               String        @db.VarChar(160)
  phone              String?       @db.VarChar(40)
  role               UserRole
  status             UserStatus    @default(ACTIVE)
  emailVerifiedAt    DateTime?
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  cases              ClientCase[]  @relation("CaseClient")
  uploadedDocuments PortalDocument[] @relation("DocumentUploader")
  sessions           UserSession[]
  auditEvents        AuditEvent[]
  appointments       Appointment[]
  notifications      Notification[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([role, status])
}

model UserSession {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.VarChar(30)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ClientCase {
  id          String     @id @default(cuid()) @db.VarChar(30)
  reference   String     @unique @db.VarChar(40)
  title       String     @db.VarChar(180)
  summary     String?    @db.Text
  status      CaseStatus @default(OPEN)
  clientId    String     @db.VarChar(30)
  serviceId   String?    @db.VarChar(30)
  openedAt    DateTime   @default(now())
  closedAt    DateTime?
  client      User       @relation("CaseClient", fields: [clientId], references: [id], onDelete: Restrict)
  service     Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  documents   PortalDocument[]
  appointments Appointment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clientId, status, updatedAt])
  @@index([serviceId, status])
}

model PortalDocument {
  id               String               @id @default(cuid()) @db.VarChar(30)
  caseId           String               @db.VarChar(30)
  uploadedById     String               @db.VarChar(30)
  originalName     String               @db.VarChar(255)
  storageKey       String               @unique @db.VarChar(500)
  mimeType         String               @db.VarChar(120)
  sizeBytes        BigInt
  checksum         String?              @db.Char(64)
  encryptionKeyRef String               @db.VarChar(120)
  status           PortalDocumentStatus @default(UPLOADED)
  reviewedAt       DateTime?
  case             ClientCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy       User                 @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([caseId, status, createdAt])
  @@index([uploadedById, createdAt])
}

model Appointment {
  id          String            @id @default(cuid()) @db.VarChar(30)
  clientId    String            @db.VarChar(30)
  caseId      String?           @db.VarChar(30)
  startsAt    DateTime
  durationMin Int               @default(30)
  timezone    String            @db.VarChar(80)
  status      AppointmentStatus @default(REQUESTED)
  notes       String?           @db.VarChar(1000)
  client      User              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  case        ClientCase?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clientId, startsAt])
  @@index([caseId, startsAt])
  @@index([status, startsAt])
}

model Notification {
  id        String              @id @default(cuid()) @db.VarChar(30)
  userId    String?             @db.VarChar(30)
  leadId    String?             @db.VarChar(30)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  template  String              @db.VarChar(120)
  payload   Json?
  sentAt    DateTime?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead      Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([leadId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid()) @db.VarChar(30)
  actorId    String?  @db.VarChar(30)
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(100)
  changes    Json?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}
